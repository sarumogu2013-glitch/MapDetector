{
  "name": "mapdetector",
  "productName": "MapDetector",
  "version": "0.7.5",
  "description": "ローカルタイル表示・座標取得・図面/線形SIMAオーバーレイ (横断線 魚の骨表示)",
  "main": "electron/main.js",
  "author": "sarumogu2013-glitch",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarumogu2013-glitch/MapDetector.git"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "prestart": "node scripts/sync-version.js",
    "start": "electron .",
    "test": "node --test",
    "prebuild": "node scripts/sync-version.js",
    "build": "electron-builder --win --publish never",
    "release": "node scripts/sync-version.js && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.sarumogu2013-glitch.mapdetector",
    "productName": "MapDetector",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MapDetector-Setup-${version}.${ext}",
      "shortcutName": "MapDetector"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sarumogu2013-glitch",
        "repo": "MapDetector",
        "releaseType": "release"
      }
    ]
  }
}
